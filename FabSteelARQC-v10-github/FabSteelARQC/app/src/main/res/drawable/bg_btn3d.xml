<?xml version="1.0" encoding="utf-8"?>
<!-- دکمه‌ی سه‌بعدی: سایه‌ی پایین + بدنه‌ی گرادیانی + لبه‌ی روشن + براق بالا -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#88000000" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/btn_bottom"
                android:startColor="@color/btn_top" />
            <stroke
                android:width="2dp"
                android:color="@color/btn_stroke" />
        </shape>
    </item>
    <item
        android:bottom="50%"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
